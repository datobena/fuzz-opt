#!/usr/bin/env python3
"""Time a deterministic replay of the fixed corpus on the current build.

This is the acceptance measurement: keep a fold only if it beats the previous
best. Usage: fold-replay-time [repeats]
"""
import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _client import main
repeats = int(sys.argv[1]) if len(sys.argv) > 1 else 3
raise SystemExit(main({"op": "replay_time", "repeats": repeats}))
