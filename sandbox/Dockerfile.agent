# syntax=docker/dockerfile:1
# Container the phase-2 optimizer agent runs inside.
#
# Carries local tooling the agent legitimately needs to read and edit source
# (editors, grep, python) and the agent CLI itself -- but deliberately NO docker
# client. All build/smoke/replay work goes over /run/broker.sock, so a docker
# binary here would be either useless or a hole.
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git python3 python3-pip ripgrep less vim-tiny \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# Node is required by the Claude Code CLI.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code

# A non-root user: the agent has no reason to be root, and /work/src is
# bind-mounted from the host, so the uid must match the host owner (1000) or the
# agent cannot write to the source it is supposed to edit.
#
# ubuntu:24.04 ships its own uid-1000 user ("ubuntu"), which must be removed
# first. Deliberately NOT `|| true`: that masked the collision, useradd failed,
# and `USER agent` then referred to a user that did not exist -- every container
# died at startup with "unable to find user agent".
RUN userdel -r ubuntu 2>/dev/null || true; \
    useradd -m -u 1000 -s /bin/bash agent && \
    id agent
USER agent

# Pre-create the CLI's config dir, owned by the agent.
#
# Docker creates the missing PARENT of a bind mount as root. The credential is
# mounted at /home/agent/.claude/.credentials.json and the skill under
# /home/agent/.claude/skills/, so without this /home/agent/.claude comes into
# existence root-owned and uid 1000 cannot write to it. The CLI creates
# ~/.claude/session-env when it first runs a command, so that fails with EACCES
# and the Bash tool is dead for the whole session -- no build, no smoke, no
# replay, no reading the FUZZ_SOURCE_FOLDS_* contract. The agent then correctly
# reports BLOCKED_LOW_CONFIDENCE, which is indistinguishable from "the optimizer
# had nothing to say" unless you read its reasoning.
#
# Created here (after USER agent) so the mounts land in a directory that already
# exists with the right owner.
RUN mkdir -p /home/agent/.claude/skills

ENV PATH="/work/bin:${PATH}"
WORKDIR /work/src
