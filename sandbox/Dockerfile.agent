# syntax=docker/dockerfile:1
# Container the phase-2 optimizer agent runs inside.
#
# Carries local tooling the agent legitimately needs to read and edit source
# (editors, grep, python) and the agent CLI itself -- but deliberately NO docker
# client. All build/smoke/replay work goes over /run/broker.sock, so a docker
# binary here would be either useless or a hole.
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git python3 python3-pip ripgrep less vim-tiny \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# Node is required by the Claude Code CLI.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code

# A non-root user: the agent has no reason to be root, and /work/src is
# bind-mounted from the host, so the uid must match the host owner (1000) or the
# agent cannot write to the source it is supposed to edit.
#
# ubuntu:24.04 ships its own uid-1000 user ("ubuntu"), which must be removed
# first. Deliberately NOT `|| true`: that masked the collision, useradd failed,
# and `USER agent` then referred to a user that did not exist -- every container
# died at startup with "unable to find user agent".
RUN userdel -r ubuntu 2>/dev/null || true; \
    useradd -m -u 1000 -s /bin/bash agent && \
    id agent
USER agent

ENV PATH="/work/bin:${PATH}"
WORKDIR /work/src
