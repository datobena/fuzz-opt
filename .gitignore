# Experiment outputs (545 GB of corpora, binaries, logs) — never commit
results/

# Python caches
__pycache__/
*.pyc
*.pyo

# Generated report artifacts
report_kube_figures/
report_kube_records.json.gz

# Stray local tooling marker
.codex

# Local seed-corpus cache (data, not code)
corpus_cache/

# Bulk experiment data dirs (corpora/coverage replay artifacts, GB-scale) — never commit
local_pinned/
hotspotdiff/
covdiff/
covdiff_pertrial/
covdiff_pertrial_aggr8h/
covdiff_pertrial_mut8h/
.cache/

# Run logs and local run-marker pointer files
*.log
.*_logname

# prework: staged source is a build artifact, not source of record
prework/targets/*/src/
sandbox/Dockerfile.egress

# sandbox credential store (contains live OAuth tokens)
.sandbox-creds/

# Local run bookkeeping (PID files, renamed run logs, ad-hoc backups)
.online_*_pids.txt
*.log.failed-*
.skill-backup-*
manifest.json.bak-*

# `results` is a symlink to machine-local bulk storage on this host
results

# Line-coverage replay artifacts (11 GB) and the FuzzBench AFL smoke tree (281 MB)
.linecov/
.fb_afl_test/

# Per-project run-marker PID files
.online_*.pid

# Ad-hoc pre-change snapshots taken while editing (`.<file>.pre-<change>`)
.*.pre-*
*.bak
*.cold-bak

# FuzzBench seed testcases are corpus data, not target definitions
prework/fuzzbench/*/testcases/
